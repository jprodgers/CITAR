{
  "name": "power-minute",
  "about": "Once a minute the helper sends its 10-second samples; the hub writes them as the machine's power rows.",
  "refs": ["P4.2.3", "P4.3.5"],
  "plays": {"helper": "4-06", "hub": "4-06"},
  "values": {
    "key": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
    "machine": "sv_0123456789abcdef",
    "token": "cwt_example_0123456789abcdef0123456789abcdef"
  },
  "setup": {"helper": {"clock": "fake"}, "hub": {}},
  "steps": [
    {
      "h2s": {
        "t": "hello",
        "protocol": 2,
        "token": "<id:token>",
        "helper": {
          "version": "<string>",
          "build": "<hex12>",
          "jobs_build": "<any>",
          "target": "<string>",
          "label": "<string>"
        },
        "machine": {
          "hostname": "<string>",
          "name": "<string>",
          "os": "<string>",
          "arch": "<string>",
          "public_key": "<id:key>"
        },
        "llm": "<any>",
        "cpu": "<any>",
        "report": "<any>",
        "running": [],
        "results": [],
        "updates": "<string>",
        "quiet_until": "<any>"
      }
    },
    {
      "s2h": {
        "t": "welcome",
        "protocol": 2,
        "machine": {"id": "<id:machine>", "name": "<string>"},
        "settings": "<any>",
        "ping_s": "<int:5..300>",
        "server": {"version": "<string>", "build": "<hex12>", "jobs_build": "<any>"},
        "update": null,
        "jobs": {"keep": [], "drop": [], "resend": []}
      },
      "within_s": 5
    },
    {"h2s": {"t": "settings_ack", "effective": "<any>", "capped": "<any>", "limits": "<any>"}},
    {"wait": {"s": 60}},
    {
      "h2s": {
        "t": "power",
        "samples": [
          {"t": "<number>", "gpu_w": "<any>", "cpu_util": "<number:0..1>"},
          {"t": "<number>", "gpu_w": "<any>", "cpu_util": "<number:0..1>"},
          {"t": "<number>", "gpu_w": "<any>", "cpu_util": "<number:0..1>"},
          {"t": "<number>", "gpu_w": "<any>", "cpu_util": "<number:0..1>"},
          {"t": "<number>", "gpu_w": "<any>", "cpu_util": "<number:0..1>"},
          {"t": "<number>", "gpu_w": "<any>", "cpu_util": "<number:0..1>"}
        ]
      },
      "within_s": 5
    },
    {"state": {"side": "hub", "expect": {"power_rows": 1}}}
  ]
}
