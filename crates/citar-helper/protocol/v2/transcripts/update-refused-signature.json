{
  "name": "update-refused-signature",
  "about": "A manifest whose signature does not verify is refused, and nothing is downloaded.",
  "refs": ["P4.2.6", "P4.3.8"],
  "plays": {"helper": "4-13", "hub": null},
  "one_side": "the hub relays only manifests that verify; this scripts a server that relays a bad one",
  "values": {
    "key": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
    "machine": "sv_0123456789abcdef",
    "token": "cwt_example_0123456789abcdef0123456789abcdef"
  },
  "setup": {"helper": {"config": {"updates": "auto"}, "update_key": "test"}, "hub": {}},
  "steps": [
    {
      "h2s": {
        "t": "hello",
        "protocol": 2,
        "token": "<id:token>",
        "helper": {
          "version": "<string>",
          "build": "<hex12>",
          "jobs_build": "<any>",
          "target": "<string>",
          "label": "<string>"
        },
        "machine": {
          "hostname": "<string>",
          "name": "<string>",
          "os": "<string>",
          "arch": "<string>",
          "public_key": "<id:key>"
        },
        "llm": "<any>",
        "cpu": "<any>",
        "report": "<any>",
        "running": [],
        "results": [],
        "updates": "<string>",
        "quiet_until": "<any>"
      }
    },
    {
      "s2h": {
        "t": "welcome",
        "protocol": 2,
        "machine": {"id": "<id:machine>", "name": "<string>"},
        "settings": "<any>",
        "ping_s": "<int:5..300>",
        "server": {"version": "<string>", "build": "<hex12>", "jobs_build": "<any>"},
        "update": {"manifest": "<string>", "signature": "<base64>"},
        "jobs": {"keep": [], "drop": [], "resend": []}
      },
      "within_s": 5
    },
    {"h2s": {"t": "settings_ack", "effective": "<any>", "capped": "<any>", "limits": "<any>"}},
    {
      "h2s": {"t": "update_status", "state": "refused", "version": "<any>", "message": "<string>"},
      "within_s": 5
    },
    {"state": {"side": "helper", "expect": {"downloads": 0}}}
  ]
}
