{
  "name": "status-quiet-hours",
  "about": "When the helper's own quiet hours begin it says so in a status frame, and the scheduler treats the machine as in quiet hours.",
  "refs": ["P4.2.3", "P4.5.3"],
  "plays": {"helper": "4-03", "hub": "4-05"},
  "values": {
    "key": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
    "machine": "sv_0123456789abcdef",
