      },
      "clock": "fake"
    },
    "hub": {
      "machine": {
        "settings": {
          "llm": {"enabled": false, "slots": 1, "allow_swaps": false},
          "cpu": {
            "enabled": false,
            "threads": 1,
            "cpu_percent": 10,
            "memory_mb": 512,
            "work": ["lab_game"],
            "yield_to_llm": true
          }
        }
      }
    }
  },
  "steps": [
    {
      "h2s": {
        "t": "hello",
        "protocol": 2,
        "token": "<id:token>",
        "helper": {
          "version": "<string>",
          "build": "<hex12>",
          "jobs_build": "<any>",
          "target": "<string>",
          "label": "<string>"
        },
        "machine": {
          "hostname": "<string>",
          "name": "<string>",
          "os": "<string>",
          "arch": "<string>",
          "public_key": "<id:key>"
        },
        "llm": "<any>",
        "cpu": "<any>",
        "report": "<any>",
        "running": [],
        "results": [],
        "updates": "<string>",
        "quiet_until": "<any>"
      }
    },
    {
      "s2h": {
        "t": "welcome",
        "protocol": 2,
        "machine": {"id": "<id:machine>", "name": "<string>"},
        "settings": {
          "llm": {"enabled": false, "slots": 1, "allow_swaps": false},
          "cpu": {
            "enabled": false,
            "threads": 1,
            "cpu_percent": 10,
            "memory_mb": 512,
            "work": ["lab_game"],
            "yield_to_llm": true
          }
        },
        "ping_s": "<int:5..300>",
        "server": {"version": "<string>", "build": "<hex12>", "jobs_build": "<any>"},
        "update": null,
        "jobs": {"keep": [], "drop": [], "resend": []}
      },
      "within_s": 5
    },
    {
      "h2s": {
        "t": "settings_ack",
        "effective": {
          "llm": {"enabled": false, "slots": 1},
          "cpu": {
            "enabled": false,
            "threads": 1,
            "cpu_percent": 10,
            "memory_mb": 512,
            "work": ["lab_game"],
            "yield_to_llm": true
          }
        },
        "capped": [],
        "limits": "<any>"
      }
    },
    {"act": {"side": "helper", "do": "quiet_begins"}},
    {
      "h2s": {
        "t": "status",
        "quiet_until": "<id:quiet_until>",
        "llm_in_flight": 0,
        "jobs_running": 0,
        "jobs_paused": 0
      },
      "within_s": 5
    },
    {"state": {"side": "hub", "expect": {"quiet": true}}}
  ]
