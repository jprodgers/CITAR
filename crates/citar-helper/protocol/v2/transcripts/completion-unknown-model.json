{
  "name": "completion-unknown-model",
  "about": "A model outside the helper's allowlist is refused unknown_model, not retryable: the request fails, not retried on that machine. The hub routes a model only to machines whose catalog has it, so its side sends this one through its test hook.",
  "refs": ["P4.2.4", "P4.3.3"],
  "plays": {"helper": "4-04", "hub": "4-05"},
  "values": {
    "key": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
    "machine": "sv_0123456789abcdef",
    "req": "0123456789abcdef",
    "token": "cwt_example_0123456789abcdef0123456789abcdef"
  },
  "setup": {
    "helper": {
      "config": {
        "max_concurrent": 1,
        "models": ["model-a"],
        "cpu": {"enabled": false, "threads": 1, "cpu_percent": 10, "memory_mb": 512, "work": ["lab_game"]}
      },
      "endpoint": {"models": [{"key": "model-a", "label": "Model A", "context": 8192, "loaded": true}]}
    },
    "hub": {
      "machine": {
        "settings": {
          "llm": {"enabled": true, "slots": 1, "allow_swaps": false},
          "cpu": {
            "enabled": false,
            "threads": 1,
            "cpu_percent": 10,
            "memory_mb": 512,
            "work": ["lab_game"],
            "yield_to_llm": true
          }
        }
      }
    }
  },
  "steps": [
    {
      "h2s": {
        "t": "hello",
        "protocol": 2,
        "token": "<id:token>",
        "helper": {
          "version": "<string>",
          "build": "<hex12>",
          "jobs_build": "<any>",
          "target": "<string>",
          "label": "<string>"
        },
        "machine": {
          "hostname": "<string>",
          "name": "<string>",
          "os": "<string>",
          "arch": "<string>",
          "public_key": "<id:key>"
        },
        "llm": {
          "enabled": true,
          "provider": "<any>",
          "slots": 1,
          "stream": "<bool>",
          "models": [{"key": "model-a", "label": "Model A", "context": 8192, "loaded": true}]
        },
        "cpu": "<any>",
        "report": "<any>",
        "running": [],
        "results": [],
        "updates": "<string>",
        "quiet_until": "<any>"
      }
    },
    {
      "s2h": {
        "t": "welcome",
        "protocol": 2,
        "machine": {"id": "<id:machine>", "name": "<string>"},
        "settings": {
          "llm": {"enabled": true, "slots": 1, "allow_swaps": false},
          "cpu": {
            "enabled": false,
            "threads": 1,
            "cpu_percent": 10,
            "memory_mb": 512,
            "work": ["lab_game"],
            "yield_to_llm": true
          }
        },
        "ping_s": "<int:5..300>",
        "server": {"version": "<string>", "build": "<hex12>", "jobs_build": "<any>"},
        "update": null,
        "jobs": {"keep": [], "drop": [], "resend": []}
      },
      "within_s": 5
    },
    {
      "h2s": {
        "t": "settings_ack",
        "effective": {
          "llm": {"enabled": true, "slots": 1},
          "cpu": {
            "enabled": false,
            "threads": 1,
            "cpu_percent": 10,
            "memory_mb": 512,
            "work": ["lab_game"],
            "yield_to_llm": true
          }
        },
        "capped": [],
        "limits": "<any>"
      }
    },
    {"act": {"side": "hub", "do": "force_request"}},
    {
      "s2h": {
        "t": "request",
        "id": "<id:req>",
        "model": "model-z",
        "messages": [{"role": "system", "content": "<string>"}, {"role": "user", "content": "<string>"}],
        "tools": "<any>",
        "params": "<any>",
        "timeout_s": "<number>"
      }
    },
    {
      "h2s": {"t": "error", "id": "<id:req>", "code": "unknown_model", "message": "<string>", "retryable": false},
      "within_s": 2
    },
    {"state": {"side": "hub", "expect": {"request": {"id": "<id:req>", "failed": "unknown_model"}}}}
  ]
}
