{
  "name": "cancel-mid-stream",
  "about": "A cancel mid-stream drops the stream: the endpoint sees its client go within 1 s and sends no token after; cancelled carries the tokens received so far.",
  "refs": ["P4.2.4", "P4.3.4"],
  "plays": {"helper": "4-04", "hub": "4-05"},
  "values": {
    "key": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
    "machine": "sv_0123456789abcdef",
    "req": "0123456789abcdef",
    "token": "cwt_example_0123456789abcdef0123456789abcdef"
  },
  "setup": {
    "helper": {
      "config": {
        "max_concurrent": 1,
        "models": ["model-a"],
        "cpu": {"enabled": false, "threads": 1, "cpu_percent": 10, "memory_mb": 512, "work": ["lab_game"]}
      },
      "endpoint": {"models": [{"key": "model-a", "label": "Model A", "context": 8192, "loaded": true}]}
    },
    "hub": {
      "machine": {
        "settings": {
          "llm": {"enabled": true, "slots": 1, "allow_swaps": false},
          "cpu": {
            "enabled": false,
            "threads": 1,
            "cpu_percent": 10,
            "memory_mb": 512,
            "work": ["lab_game"],
            "yield_to_llm": true
          }
        }
      }
    }
  },
  "steps": [
    {
      "h2s": {
        "t": "hello",
        "protocol": 2,
        "token": "<id:token>",
        "helper": {
          "version": "<string>",
          "build": "<hex12>",
          "jobs_build": "<any>",
          "target": "<string>",
          "label": "<string>"
        },
        "machine": {
          "hostname": "<string>",
          "name": "<string>",
          "os": "<string>",
          "arch": "<string>",
          "public_key": "<id:key>"
        },
        "llm": {
          "enabled": true,
          "provider": "<any>",
          "slots": 1,
          "stream": "<bool>",
          "models": [{"key": "model-a", "label": "Model A", "context": 8192, "loaded": true}]
        },
        "cpu": "<any>",
        "report": "<any>",
        "running": [],
        "results": [],
        "updates": "<string>",
        "quiet_until": "<any>"
      }
    },
    {
      "s2h": {
        "t": "welcome",
        "protocol": 2,
        "machine": {"id": "<id:machine>", "name": "<string>"},
        "settings": {
          "llm": {"enabled": true, "slots": 1, "allow_swaps": false},
          "cpu": {
            "enabled": false,
            "threads": 1,
            "cpu_percent": 10,
            "memory_mb": 512,
            "work": ["lab_game"],
            "yield_to_llm": true
          }
        },
        "ping_s": "<int:5..300>",
        "server": {"version": "<string>", "build": "<hex12>", "jobs_build": "<any>"},
        "update": null,
        "jobs": {"keep": [], "drop": [], "resend": []}
      },
      "within_s": 5
    },
    {
      "h2s": {
        "t": "settings_ack",
        "effective": {
          "llm": {"enabled": true, "slots": 1},
          "cpu": {
            "enabled": false,
            "threads": 1,
            "cpu_percent": 10,
            "memory_mb": 512,
            "work": ["lab_game"],
            "yield_to_llm": true
          }
        },
        "capped": [],
        "limits": "<any>"
      }
    },
    {"act": {"side": "hub", "do": "submit_request"}},
    {
      "s2h": {
        "t": "request",
        "id": "<id:req>",
        "model": "model-a",
        "messages": [{"role": "system", "content": "<string>"}, {"role": "user", "content": "<string>"}],
        "tools": "<any>",
        "params": "<any>",
        "timeout_s": "<number>"
      }
    },
    {
      "endpoint": {
        "respond": {
          "stream": [
            {
              "choices": [{"index": 0, "delta": {"role": "assistant", "content": "w0 "}, "finish_reason": null}]
            },
            {"choices": [{"index": 0, "delta": {"content": "w1 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w2 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w3 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w4 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w5 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w6 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w7 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w8 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w9 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w10 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w11 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w12 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w13 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w14 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w15 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w16 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w17 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w18 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w19 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w20 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w21 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w22 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w23 "}, "finish_reason": null}]},
            {"choices": [{"index": 0, "delta": {"content": "w24 "}, "finish_reason": null}]}
          ],
          "delay_ms": 200
        }
      }
    },
    {"wait": {"s": 1}},
    {"act": {"side": "hub", "do": "cancel_request"}},
    {"s2h": {"t": "cancel", "id": "<id:req>"}},
    {"endpoint": {"expect_disconnect_within_ms": 1000}},
    {"endpoint": {"expect_no_tokens_after": "disconnect"}},
    {
      "h2s": {"t": "cancelled", "id": "<id:req>", "gen_s": "<number>", "tokens_out": "<int:1..>"},
      "within_s": 1
    },
    {"state": {"side": "hub", "expect": {"slot_free": true, "draining": 0}}}
  ]
}
