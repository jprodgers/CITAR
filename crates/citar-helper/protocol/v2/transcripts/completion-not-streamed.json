{
  "name": "completion-not-streamed",
  "about": "With stream off the helper sends one non-streaming request and returns its message raw, with streamed false.",
  "refs": ["P4.2.4", "P4.3.4"],
  "plays": {"helper": "4-04", "hub": "4-05"},
  "values": {
    "key": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
    "machine": "sv_0123456789abcdef",
    "req": "0123456789abcdef",
    "token": "cwt_example_0123456789abcdef0123456789abcdef"
  },
  "setup": {
    "helper": {
      "config": {"max_concurrent": 1, "models": ["model-a"], "stream": false},
      "endpoint": {"models": [{"key": "model-a", "label": "Model A", "context": 8192, "loaded": true}]}
    },
    "hub": {
      "machine": {
        "settings": {
          "llm": {"enabled": true, "slots": 1, "allow_swaps": false},
          "cpu": {
            "enabled": true,
            "threads": 2,
            "cpu_percent": 25,
            "memory_mb": 1024,
            "work": ["lab_game", "ranking_game"],
            "yield_to_llm": true
          }
        }
      }
    }
  },
  "steps": [
    {
      "h2s": {
        "t": "hello",
        "protocol": 2,
        "token": "<id:token>",
        "helper": {
          "version": "<string>",
          "build": "<hex12>",
          "jobs_build": "<any>",
          "target": "<string>",
          "label": "<string>"
        },
        "machine": {
          "hostname": "<string>",
          "name": "<string>",
          "os": "<string>",
          "arch": "<string>",
          "public_key": "<id:key>"
        },
        "llm": "<any>",
        "cpu": "<any>",
        "report": "<any>",
        "running": [],
        "results": [],
        "updates": "<string>",
        "quiet_until": "<any>"
      }
    },
    {
      "s2h": {
        "t": "welcome",
        "protocol": 2,
        "machine": {"id": "<id:machine>", "name": "<string>"},
        "settings": "<any>",
        "ping_s": "<int:5..300>",
        "server": {"version": "<string>", "build": "<hex12>", "jobs_build": "<any>"},
        "update": null,
        "jobs": {"keep": [], "drop": [], "resend": []}
      },
      "within_s": 5
    },
    {"h2s": {"t": "settings_ack", "effective": "<any>", "capped": "<any>", "limits": "<any>"}},
    {
      "s2h": {
        "t": "request",
        "id": "<id:req>",
        "model": "model-a",
        "messages": [{"role": "system", "content": "<string>"}, {"role": "user", "content": "<string>"}],
        "tools": "<any>",
        "params": "<any>",
        "timeout_s": "<number>"
      }
    },
    {"endpoint": {"expect_request": {"model": "model-a", "stream": false}}},
    {
      "endpoint": {
        "respond": {
          "json": {
            "choices": [{"index": 0, "finish_reason": "stop", "message": {"role": "assistant", "content": "Hello."}}],
            "usage": {"prompt_tokens": 9, "completion_tokens": 2}
          }
        }
      }
    },
    {
      "h2s": {
        "t": "done",
        "id": "<id:req>",
        "message": {"content": "Hello.", "reasoning": null, "tool_calls": []},
        "finish_reason": "stop",
        "usage": {"prompt_tokens": 9, "completion_tokens": 2, "reasoning_tokens": null, "cached_tokens": null},
        "gen_s": "<number>",
        "ttft_s": "<any>",
        "streamed": false
      },
      "within_s": 5
    }
  ]
}
