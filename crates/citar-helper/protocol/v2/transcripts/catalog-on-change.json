{
  "name": "catalog-on-change",
  "about": "When the endpoint's loaded set changes, the helper sends a catalog within its 30 s poll; the hub's catalog follows it.",
  "refs": ["P4.2.3", "P4.3.4"],
  "plays": {"helper": "4-03", "hub": "4-05"},
  "values": {
    "key": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
    "machine": "sv_0123456789abcdef",
    "token": "cwt_example_0123456789abcdef0123456789abcdef"
  },
  "setup": {
    "helper": {
      "config": {
        "max_concurrent": 1,
        "cpu": {"enabled": false, "threads": 1, "cpu_percent": 10, "memory_mb": 512, "work": ["lab_game"]}
      },
      "clock": "fake",
      "endpoint": {"models": [{"key": "model-a", "label": "Model A", "context": 8192, "loaded": true}]}
    },
    "hub": {
      "machine": {
        "settings": {
          "llm": {"enabled": false, "slots": 1, "allow_swaps": false},
          "cpu": {
            "enabled": false,
            "threads": 1,
            "cpu_percent": 10,
            "memory_mb": 512,
            "work": ["lab_game"],
            "yield_to_llm": true
          }
        }
      }
    }
  },
  "steps": [
    {
      "h2s": {
        "t": "hello",
        "protocol": 2,
        "token": "<id:token>",
        "helper": {
          "version": "<string>",
          "build": "<hex12>",
          "jobs_build": "<any>",
          "target": "<string>",
          "label": "<string>"
        },
        "machine": {
          "hostname": "<string>",
          "name": "<string>",
          "os": "<string>",
          "arch": "<string>",
          "public_key": "<id:key>"
        },
        "llm": {
          "enabled": "<bool>",
          "provider": "lmstudio",
          "slots": 1,
          "stream": "<bool>",
          "models": [{"key": "model-a", "label": "Model A", "context": 8192, "loaded": true}]
        },
        "cpu": "<any>",
        "report": "<any>",
        "running": [],
        "results": [],
        "updates": "<string>",
        "quiet_until": "<any>"
      }
    },
    {
      "s2h": {
        "t": "welcome",
        "protocol": 2,
        "machine": {"id": "<id:machine>", "name": "<string>"},
        "settings": {
          "llm": {"enabled": false, "slots": 1, "allow_swaps": false},
          "cpu": {
            "enabled": false,
            "threads": 1,
            "cpu_percent": 10,
            "memory_mb": 512,
            "work": ["lab_game"],
            "yield_to_llm": true
          }
        },
        "ping_s": "<int:5..300>",
        "server": {"version": "<string>", "build": "<hex12>", "jobs_build": "<any>"},
        "update": null,
        "jobs": {"keep": [], "drop": [], "resend": []}
      },
      "within_s": 5
    },
    {
      "h2s": {
        "t": "settings_ack",
        "effective": {
          "llm": {"enabled": false, "slots": 1},
          "cpu": {
            "enabled": false,
            "threads": 1,
            "cpu_percent": 10,
            "memory_mb": 512,
            "work": ["lab_game"],
            "yield_to_llm": true
          }
        },
        "capped": [],
        "limits": "<any>"
      }
    },
    {
      "endpoint": {
        "models": [
          {"key": "model-a", "label": "Model A", "context": 8192, "loaded": false},
          {"key": "model-b", "label": "Model B", "context": null, "loaded": true}
        ]
      }
    },
    {
      "h2s": {
        "t": "catalog",
        "models": [
          {"key": "model-a", "label": "Model A", "context": 8192, "loaded": false},
          {"key": "model-b", "label": "Model B", "context": null, "loaded": true}
        ]
      },
      "within_s": 35
    },
    {"state": {"side": "hub", "expect": {"models": ["model-a", "model-b"], "loaded": ["model-b"]}}}
  ]
}
