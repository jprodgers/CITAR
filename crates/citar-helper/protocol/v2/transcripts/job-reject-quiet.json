{
  "name": "job-reject-quiet",
  "about": "In its local quiet hours the helper rejects an offer quiet.",
  "refs": ["P4.2.5", "P4.3.3"],
  "plays": {"helper": "4-10", "hub": null},
  "one_side": "the dispatcher offers nothing to a machine whose helper reported quiet hours; the reject is the helper's net for an offer already on its way",
  "values": {
    "job": "cj_0123456789abcdef",
    "jobs_build": "0f1e2d3c4b5a",
    "key": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
    "machine": "sv_0123456789abcdef",
    "run": "cr_0123456789abcdef",
    "token": "cwt_example_0123456789abcdef0123456789abcdef"
  },
  "setup": {
    "helper": {
      "config": {
        "cpu": {"enabled": true, "threads": 1, "cpu_percent": 50, "memory_mb": 1024, "work": ["lab_game"]},
        "quiet": "22:00-06:00"
      },
      "clock": "fake"
    },
    "hub": {
      "machine": {
        "settings": {
          "llm": {"enabled": true, "slots": 1, "allow_swaps": false},
          "cpu": {
            "enabled": true,
            "threads": 1,
            "cpu_percent": 50,
            "memory_mb": 1024,
            "work": ["lab_game"],
            "yield_to_llm": true
          }
        },
        "trust": "trusted"
      }
    }
  },
  "steps": [
    {
      "h2s": {
        "t": "hello",
        "protocol": 2,
        "token": "<id:token>",
        "helper": {
          "version": "<string>",
          "build": "<hex12>",
          "jobs_build": "<any>",
          "target": "<string>",
          "label": "<string>"
        },
        "machine": {
          "hostname": "<string>",
          "name": "<string>",
          "os": "<string>",
          "arch": "<string>",
          "public_key": "<id:key>"
        },
        "llm": "<any>",
        "cpu": "<any>",
        "report": "<any>",
        "running": [],
        "results": [],
        "updates": "<string>",
        "quiet_until": "<any>"
      }
    },
    {
      "s2h": {
        "t": "welcome",
        "protocol": 2,
        "machine": {"id": "<id:machine>", "name": "<string>"},
        "settings": "<any>",
        "ping_s": "<int:5..300>",
        "server": {"version": "<string>", "build": "<hex12>", "jobs_build": "<any>"},
        "update": null,
        "jobs": {"keep": [], "drop": [], "resend": []}
      },
      "within_s": 5
    },
    {"h2s": {"t": "settings_ack", "effective": "<any>", "capped": "<any>", "limits": "<any>"}},
    {"act": {"side": "helper", "do": "quiet_begins"}},
    {
      "h2s": {"t": "status", "quiet_until": "<number>", "llm_in_flight": 0, "jobs_running": 0, "jobs_paused": 0}
    },
    {
      "s2h": {
        "t": "job_offer",
        "job": "<id:job>",
        "run": "<id:run>",
        "kind": "lab_game",
        "spec": "<golden:jobs/duel-a/spec>",
        "spec_hash": "<golden:jobs/duel-a/spec_hash>",
        "jobs_build": "<id:jobs_build>",
        "deadline_s": "<number>",
        "mem_mb": "<int>",
        "priority": "<int:-100..100>",
        "offer_ttl_s": 30
      }
    },
    {"h2s": {"t": "job_reject", "run": "<id:run>", "reason": "quiet"}, "within_s": 2}
  ]
}
