{
  "name": "jobs-pause",
  "about": "A benchmark lease going live pauses every running game; the helper reports the pause in status and the paused time in progress, and resumes on jobs_resume.",
  "refs": ["P4.2.5", "P4.3.6", "P4.5.5"],
  "plays": {"helper": "4-10", "hub": "4-10"},
  "values": {
    "job": "cj_0123456789abcdef",
    "jobs_build": "0f1e2d3c4b5a",
    "key": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
    "machine": "sv_0123456789abcdef",
    "run": "cr_0123456789abcdef",
    "token": "cwt_example_0123456789abcdef0123456789abcdef"
  },
  "setup": {
    "helper": {
      "config": {"cpu": {"enabled": true, "threads": 1, "cpu_percent": 50, "memory_mb": 1024, "work": ["lab_game"]}}
    },
    "hub": {
      "machine": {
        "settings": {
          "llm": {"enabled": true, "slots": 1, "allow_swaps": false},
          "cpu": {
            "enabled": true,
            "threads": 1,
            "cpu_percent": 50,
            "memory_mb": 1024,
            "work": ["lab_game"],
            "yield_to_llm": true
          }
        },
        "trust": "trusted"
      }
    }
  },
  "steps": [
    {
      "h2s": {
        "t": "hello",
        "protocol": 2,
        "token": "<id:token>",
        "helper": {
          "version": "<string>",
          "build": "<hex12>",
          "jobs_build": "<any>",
          "target": "<string>",
          "label": "<string>"
        },
        "machine": {
          "hostname": "<string>",
          "name": "<string>",
          "os": "<string>",
          "arch": "<string>",
          "public_key": "<id:key>"
        },
        "llm": "<any>",
        "cpu": "<any>",
        "report": "<any>",
        "running": [],
        "results": [],
        "updates": "<string>",
        "quiet_until": "<any>"
      }
    },
    {
      "s2h": {
        "t": "welcome",
        "protocol": 2,
        "machine": {"id": "<id:machine>", "name": "<string>"},
        "settings": "<any>",
        "ping_s": "<int:5..300>",
        "server": {"version": "<string>", "build": "<hex12>", "jobs_build": "<any>"},
        "update": null,
        "jobs": {"keep": [], "drop": [], "resend": []}
      },
      "within_s": 5
    },
    {"h2s": {"t": "settings_ack", "effective": "<any>", "capped": "<any>", "limits": "<any>"}},
    {
      "s2h": {
        "t": "job_offer",
        "job": "<id:job>",
        "run": "<id:run>",
        "kind": "lab_game",
        "spec": "<golden:jobs/duel-a/spec>",
        "spec_hash": "<golden:jobs/duel-a/spec_hash>",
        "jobs_build": "<id:jobs_build>",
        "deadline_s": "<number>",
        "mem_mb": "<int>",
        "priority": "<int:-100..100>",
        "offer_ttl_s": 30
      }
    },
    {"h2s": {"t": "job_accept", "run": "<id:run>"}},
    {"act": {"side": "hub", "do": "benchmark_start"}},
    {"s2h": {"t": "jobs_pause", "reason": "benchmark"}, "within_s": 2},
    {
      "h2s": {"t": "status", "quiet_until": "<any>", "llm_in_flight": 0, "jobs_running": 1, "jobs_paused": 1},
      "within_s": 5
    },
    {"act": {"side": "hub", "do": "benchmark_end"}},
    {"s2h": {"t": "jobs_resume"}, "within_s": 2},
    {
      "h2s": {"t": "status", "quiet_until": "<any>", "llm_in_flight": 0, "jobs_running": 1, "jobs_paused": 0},
      "within_s": 5
    },
    {"host": {"progress": {"round": 10}}},
    {
      "h2s": {
        "t": "job_progress",
        "run": "<id:run>",
        "round": "<int>",
        "of": "<int>",
        "elapsed_s": "<number>",
        "cpu_s": "<number>",
        "paused_s": "<number:0.001..>",
        "peak_mb": "<number>"
      }
    }
  ]
}
