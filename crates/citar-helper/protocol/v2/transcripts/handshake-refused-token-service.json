{
  "name": "handshake-refused-token-service",
  "about": "As a service, a refused token does not exit: the helper idles and tries again after an hour.",
  "refs": ["P4.2.2", "P4.3.9"],
  "plays": {"helper": "4-03", "hub": "4-05"},
  "values": {
    "key": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
    "token": "cwt_example_0123456789abcdef0123456789abcdef"
  },
  "setup": {"helper": {"clock": "fake", "service": true}, "hub": {"token": "revoked", "clock": "fake"}},
  "steps": [
    {
      "h2s": {
        "t": "hello",
        "protocol": 2,
        "token": "<id:token>",
        "helper": {
          "version": "<string>",
          "build": "<hex12>",
          "jobs_build": "<any>",
          "target": "<string>",
          "label": "<string>"
        },
        "machine": {
          "hostname": "<string>",
          "name": "<string>",
          "os": "<string>",
          "arch": "<string>",
          "public_key": "<id:key>"
        },
        "llm": "<any>",
        "cpu": "<any>",
        "report": "<any>",
        "running": [],
        "results": [],
        "updates": "<string>",
        "quiet_until": "<any>"
      }
    },
    {"s2h": {"t": "refused", "code": "token", "message": "<string>"}, "within_s": 5},
    {"close": {"by": "server", "code": 4401}},
    {"wait": {"s": 3590, "quiet": true}},
    {"connect": {}, "within_s": 20},
    {
      "h2s": {
        "t": "hello",
        "protocol": 2,
        "token": "<id:token>",
        "helper": {
          "version": "<string>",
          "build": "<hex12>",
