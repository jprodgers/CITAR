# Copy to `.env` next to docker-compose.yml and fill in. Docker Compose reads it automatically.
#
# Only the first three are required. Everything else has a working default, and CITAR will tell you
# at startup which optional pieces are missing and what each one costs you.

# --------------------------------------------------------------------------------- required
# The domain browsers will use. A DNS A record for it must already point at this machine, or the
# certificate request will fail.
CITAR_DOMAIN=citar.example.com

# Generate once and keep it. Changing it signs everybody out and invalidates outstanding
# verification and password-reset links.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CITAR_SECRET_KEY=

# Where Let's Encrypt sends expiry warnings. Optional but worth setting.
ACME_EMAIL=you@example.com

# --------------------------------------------------------------------------------- capacity
# Games are CPU-bound. These are the levers that keep the rest of the machine responsive.
CITAR_CPUS=2.0
CITAR_MEMORY=1g

# --------------------------------------------------------------------------------- accounts
# open | invite | closed. Invite-only needs neither e-mail nor a captcha, which is why it is the
# default: a server can go live before either exists.
CITAR_REGISTRATION=invite

# --------------------------------------------------------------------------------- e-mail
# Without SMTP there is no sign-up verification and no password reset. Invitations still work.
CITAR_SMTP_HOST=
CITAR_SMTP_PORT=587
CITAR_SMTP_SECURITY=starttls
CITAR_SMTP_USER=
CITAR_SMTP_PASSWORD=
CITAR_MAIL_FROM=citar@example.com

# --------------------------------------------------------------------------------- sign-in
# Register an OAuth app with the callback
#   https://<your domain>/api/auth/oauth/github/callback
# docs/server/OAUTH.md has the steps for GitHub, Google, Discord and Microsoft.
CITAR_OAUTH_GITHUB_CLIENT_ID=
CITAR_OAUTH_GITHUB_CLIENT_SECRET=

# --------------------------------------------------------------------------------- anti-bot
# Only needed with open registration. https://hcaptcha.com
CITAR_HCAPTCHA_SITE_KEY=
CITAR_HCAPTCHA_SECRET=
