# CITAR server configuration.
#
# Copy to a file OUTSIDE the project folder (this directory syncs to OneDrive) and load it from the
# systemd unit with EnvironmentFile=, mode 0600, owned by the service account:
#
#     sudo install -m 600 -o citar -g citar citar.env /etc/citar/citar.env
#
# Nothing here is needed to run CITAR on your laptop: with no environment at all it starts in local
# mode, generates its own key, and logs you in automatically.

# ---------------------------------------------------------------------------- mode
# local   (default) loopback only, single auto-logged-in owner, no TLS or OAuth needed
# server  the public deployment: real sessions, TLS required, refuses to start half-configured
CITAR_MODE=server

# What the outside world calls this server. OAuth callbacks and emailed links are built from it.
# Must be https:// in server mode — OAuth providers reject plain-HTTP callbacks and session cookies
# need the Secure flag.
CITAR_PUBLIC_ORIGIN=https://citar.example.com

# Signing key for sessions and one-shot tokens. Generate ONCE and keep it with the deployment:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everybody out and invalidates outstanding verification links.
CITAR_SECRET_KEY=

# Bind address. Keep it on loopback and let Caddy terminate TLS in front.
CITAR_HOST=127.0.0.1
CITAR_PORT=8765

# Caddy sets X-Forwarded-For/Proto; this is how many proxy hops to trust when reading the client IP.
# Getting this wrong breaks rate limiting — too high and anyone can spoof their IP, too low and
# every request looks like it came from the proxy.
CITAR_BEHIND_PROXY=1
CITAR_TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------- database
# Default is SQLite in the data directory, which is fine for this scale. For Postgres:
#     CITAR_DB_URL=postgresql+psycopg://citar:PASSWORD@127.0.0.1:5432/citar
# CITAR_DB_URL=

# Where the database and the generated local key live. Must NOT be inside the project folder:
# OneDrive syncing a live WAL database corrupts it.
# CITAR_DATA_DIR=/var/lib/citar

# ---------------------------------------------------------------------------- registration
# open    anyone may sign up (hCaptcha + email verification + rate limits apply)
# invite  an invite code is required — the default
# closed  no new accounts at all; admins create them
CITAR_REGISTRATION=invite

# ---------------------------------------------------------------------------- email
# Needed for email/password signup, verification, password resets and emailed invites.
# Without it CITAR runs SSO-only and says so on the login page.
CITAR_SMTP_HOST=
CITAR_SMTP_PORT=587
CITAR_SMTP_SECURITY=starttls          # starttls | ssl | none
CITAR_SMTP_USER=
CITAR_SMTP_PASSWORD=
CITAR_MAIL_FROM=citar@example.com
CITAR_MAIL_FROM_NAME=CITAR

# ---------------------------------------------------------------------------- single sign-on
# Register an OAuth app with each provider you want and paste the credentials here. A provider with
# no credentials simply does not appear on the login page.
#
# The redirect / callback URL to register, for every provider:
#     https://citar.example.com/api/auth/oauth/<provider>/callback
# i.e.
#     google     https://citar.example.com/api/auth/oauth/google/callback
#     github     https://citar.example.com/api/auth/oauth/github/callback
#     discord    https://citar.example.com/api/auth/oauth/discord/callback
#     microsoft  https://citar.example.com/api/auth/oauth/microsoft/callback
#
# Where to register:
#     google     console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web)
#                Scopes: openid, email, profile. Needs a consent screen with a privacy policy URL.
#     github     github.com/settings/developers → New OAuth App
#     discord    discord.com/developers/applications → OAuth2 → scopes identify, email
#     microsoft  entra.microsoft.com → App registrations → Web platform, redirect URI as above

CITAR_OAUTH_GOOGLE_CLIENT_ID=
CITAR_OAUTH_GOOGLE_CLIENT_SECRET=

CITAR_OAUTH_GITHUB_CLIENT_ID=
CITAR_OAUTH_GITHUB_CLIENT_SECRET=

CITAR_OAUTH_DISCORD_CLIENT_ID=
CITAR_OAUTH_DISCORD_CLIENT_SECRET=

CITAR_OAUTH_MICROSOFT_CLIENT_ID=
CITAR_OAUTH_MICROSOFT_CLIENT_SECRET=
CITAR_OAUTH_MICROSOFT_TENANT=common   # "common" accepts any Microsoft account

# ---------------------------------------------------------------------------- anti-bot
# hcaptcha.com → sign up → add the site → Site key and Secret key.
# Without these, open registration falls back to rate limits and email verification alone, and the
# server logs a warning at boot.
CITAR_HCAPTCHA_SITE_KEY=
CITAR_HCAPTCHA_SECRET=

# ---------------------------------------------------------------------------- sessions
CITAR_SESSION_DAYS=30                 # absolute lifetime
CITAR_SESSION_IDLE_HOURS=336          # logged out after this long without a request (14 days)

# ---------------------------------------------------------------------------- workers
# How often a connected citar-worker must be heard from before it is treated as offline.
CITAR_WORKER_PING_SECONDS=20
