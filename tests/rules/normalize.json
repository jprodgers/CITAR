    "probe": {
      "params": [["n", "integer"], ["flag", "boolean"], ["names", "array"], ["m", "integer"], ["text", "string"], ["loose", null]],
      "required": ["n"]
    },
    "pair": {
      "params": [["a", "integer"], ["b", "string"], ["c", "integer"]],
      "required": ["b", "a"]
    }
  },
