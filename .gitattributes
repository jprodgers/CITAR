# Line endings.
#
# This repository is edited on Windows and deployed to Linux. A shell script that reaches the
# server with CRLF line endings fails in a way that reads as nonsense:
#
#     /usr/bin/env: 'bash\r': No such file or directory
#
# because the carriage return becomes part of the interpreter name. So anything that will be
# executed on the server, or read by a Linux tool that cares, is pinned to LF regardless of what
# the working copy does.

* text=auto

# Executed or parsed on Linux
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.conf      text eol=lf
Caddyfile   text eol=lf
Dockerfile  text eol=lf
.dockerignore text eol=lf

# Read by tools that are particular about it
*.py        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.mako      text eol=lf
*.rb        text eol=lf
*.md        text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.rs        text eol=lf
*.tsv       text eol=lf
*.sha256    text eol=lf
# The helper's service plans (crates/citar-helper/src/service), compared byte for byte on every OS
crates/citar-helper/tests/data/service/*.txt text eol=lf
Cargo.lock  text eol=lf
env.example text eol=lf
.env.docker.example text eol=lf

# Windows-only, and happier as it is
*.ps1       text eol=crlf
*.iss       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# The Python baselines (DESIGN.md P2.4.3), byte for byte as the laptop wrote them, CRLF and all:
# nothing can write them again once the Python engine is gone.
refcheck/baseline/python/*.jsonl -text

# Never touched
*.png  binary
*.jpg  binary
*.ico  binary
*.gz   binary
*.zip  binary
*.exe  binary
*.citar binary
*.citarscn binary
*.db     binary

# Generated: keep these out of diffs and language statistics.
crates/citar-engine/data/ruleset/*.json linguist-generated=true
wiki/* linguist-generated=true
Cargo.lock linguist-generated=true
crates/citar-engine/src/unique/gen.rs linguist-generated=true
crates/citar-bot/src/params/gen.rs linguist-generated=true

# The avatar corpus (tests/test_profiles.py): byte for byte, whatever its extension says it is.
tests/data/avatars/* binary

# A signed helper manifest (xtask's and scripts/ci/verify_manifest.py's tests): its signature covers its bytes.
tests/data/helper_manifest/* -text
