# Line endings.
#
# This repository is edited on Windows and deployed to Linux. A shell script that reaches the
# server with CRLF line endings fails in a way that reads as nonsense:
#
#     /usr/bin/env: 'bash\r': No such file or directory
#
# because the carriage return becomes part of the interpreter name. So anything that will be
# executed on the server, or read by a Linux tool that cares, is pinned to LF regardless of what
# the working copy does.

* text=auto

# Executed or parsed on Linux
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.conf      text eol=lf
Caddyfile   text eol=lf
Dockerfile  text eol=lf
.dockerignore text eol=lf

# Read by tools that are particular about it
*.py        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.mako      text eol=lf
*.rb        text eol=lf
*.md        text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
env.example text eol=lf
.env.docker.example text eol=lf

# Windows-only, and happier as it is
*.ps1       text eol=crlf
*.iss       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Never touched
*.png  binary
*.jpg  binary
*.ico  binary
*.gz   binary
*.zip  binary
*.exe  binary
*.citar binary
*.citarscn binary

# Generated: keep these out of diffs and language statistics.
citar/data/ruleset/*.json linguist-generated=true
citar/engine/unique_types.py linguist-generated=true
citar/bots/frozen_*.py linguist-generated=true
wiki/* linguist-generated=true
