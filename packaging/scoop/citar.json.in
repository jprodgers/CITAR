{
    "version": "{{version}}",
    "description": "Civilization V-style 4X game for benchmarking language models",
    "homepage": "https://github.com/jprodgers/CITAR",
    "license": "MPL-2.0",
    "notes": [
        "Run 'citar setup' to find a model and configure CITAR.",
        "Run 'citar' on its own to start playing - it opens your browser.",
        "",
        "Your games and settings are kept in %LOCALAPPDATA%\\CITAR and are not removed when you uninstall CITAR."
    ],
    "architecture": {
        "64bit": {
            "url": "{{url:CITAR-{{version}}-windows-x64.zip}}",
            "hash": "{{sha256:CITAR-{{version}}-windows-x64.zip}}"
        }
    },
    "extract_dir": "CITAR",
    "bin": [
        "citar.exe",
        [
            "citar-play.exe",
            "citar-play"
        ]
    ],
    "shortcuts": [
        [
            "citar-play.exe",
            "CITAR"
        ]
    ],
    "checkver": {
        "github": "https://github.com/jprodgers/CITAR"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jprodgers/CITAR/releases/download/v$version/CITAR-$version-windows-x64.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
